' COMPOSITION
' ============================================
MainWindow *-- CarCardsView
MainWindow *-- CarsCatalogController
MainWindow *-- RentalsModel
RentalDialog *-- CustomCalendarWidget
RentalDialog *-- RentalCalculator
Database *-- SchemaManager
Database *-- CarSeeder
Database *-- CarsRepository
Database *-- CustomersRepository
Database *-- RentalsRepository
CarsCatalogController *-- CatalogFilters
CarCardWidget *-- CarInfo
RentalDialog *-- CarInfo
RentalsModel *-- CurrencyConverter

