CarCardWidget --> CarImageLoader : uses
CarCardWidget --> CarDetailsFormatter : uses
CarCardWidget --> CarInfo : uses
CarCardWidget --> FileLoadException : catches

RentalDialog --> Database : uses
RentalDialog --> CurrencyConverter : uses
RentalDialog --> CarInfo : uses
RentalDialog --> RentalCalculator : uses
RentalDialog --> DatabaseException : catches

CustomCalendarWidget --> Database : uses

LoginDialog --> Database : uses
LoginDialog --> SessionManager : uses
LoginDialog --> DatabaseException : catches

CarsCatalogController --> Database : uses
CarsCatalogController --> CarInfo : returns
CarsCatalogController --> CatalogFilters : uses

Database --> CarsRepository : delegates (unique_ptr)
Database --> CustomersRepository : delegates
Database --> RentalsRepository : delegates
Database --> SchemaManager : uses
Database --> CarSeeder : uses
Database --> DatabaseException : throws

CarsRepository --> QSqlQueryModel : returns (unique_ptr)
CarsRepository --> QSqlDatabase : uses
CarsRepository --> CarInfo : returns

CustomersRepository --> QSqlDatabase : uses
CustomersRepository --> DatabaseException : throws

RentalsRepository --> QSqlDatabase : uses
RentalsRepository --> DatabaseException : throws

SchemaManager --> QSqlDatabase : uses
SchemaManager --> DatabaseException : throws

CarSeeder --> QSqlDatabase : uses

RentalCalculator --> CurrencyConverter : uses
RentalCalculator --> CarInfo : uses
RentalCalculator --> DateNormalization : returns

SessionManager --> SessionData : uses
SessionManager --> PathsConfig : uses

CarImageLoader --> PathsConfig : uses
